# Root .env.example - copy to .env and fill values for local dev
# Frontend (Vite) - these values are exposed to the browser
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend will read its own .env in backend/.env
# (optional) Provide a FRONTEND_URL used by the backend for CORS during local dev
FRONTEND_URL=http://localhost:5173
